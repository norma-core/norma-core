# NC lamp YOLO head: Seeed XIAO ESP32-S3 Sense (ESP32-S3R8: 8 MB flash QIO, 8 MB octal PSRAM, native USB)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: a new app boots once as "pending"; main marks it valid after everything started, else the bootloader goes back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# speed: ESP-DL numbers are measured with these
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_FREERTOS_HZ=1000

# one inference takes about a second; keep the watchdog quiet
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# serial log over the XIAO's USB-C (there is no UART bridge on the board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# camera: the driver takes ONE block of this size in DMA-capable internal RAM at every start; with 32 kB (the default)
# the start failed on every second boot (free internal RAM ~92 kB but no 32 kB piece left: Wi-Fi, httpd and the
# model fragment it). 8 kB is the smallest allowed, a few more interrupts per frame (2026-11-01).
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192

# web
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# models: coco_detect -> only the 320 x 320 YOLO11n, read from the coco_det partition
CONFIG_FLASH_COCO_DETECT_YOLO11N_S8_V1=n
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_MODEL_IN_FLASH_PARTITION=y
